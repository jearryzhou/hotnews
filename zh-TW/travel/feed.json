-16/20260916-travel-high-speed-rail.webp","ci":"✈️","ct":"旅遊","cc":"#65a30d","d":"2026年9月16日","m":"閱讀時間 1 分鐘","tg":[{"u":"/zh-TW/tag/high-speed-rail/","l":"高鐵"},{"u":"/zh-TW/tag/travel-guide/","l":"旅遊指南"}]}]}