{"lang":"ja","total":21,"items":[{"u":"/ja/autos/20260924-autos-ai-takes-over-sophisticated-investment-scams/","t":"AIが高度な投資詐欺を掌握","h":true,"s":"中国の投資家は、人工知能がより高度な「豚肥育」詐欺を実行し、被害者を大金の送金に誘導することを可能にする、AI駆動の新たな金融詐欺の波に直面しています。","i":"/img/2026-09-24/20260924-autos-ai-takes-over-sophisticated-investment-scams.webp","ci":"🚗","ct":"自動車","cc":"#64748b","d":"2026年9月24日","m":"3分で読める","tg":[{"u":"/ja/tag/technology/","l":"テクノロジー"},{"u":"/ja/tag/economy/","l":"経済"}]},{"u":"/ja/autos/20260924-autos-chinas-smartphone-giants-switch-chip-suppliers/","t":"中国のスマートフォン大手、チップサプライヤーを切り替え","h":true,"s":"中国の主要携帯電話メーカーであるOPPOとvivoが、フラッグシップモデルでMediaTekチップに切り替えることを決定。激しい競争の中での業界の転換を示唆しています。","i":"/img/2026-09-24/20260924-autos-chinas-smartphone-giants-switch-chip-suppliers.webp","ci":"🚗","ct":"自動車","cc":"#64748b","d":"2026年9月24日","m":"2分で読める","tg":[{"u":"/ja/tag/technology/","l":"テクノロジー"},{"u":"/ja/tag/manufacturing/","l":"製造"}]},{"u":"/ja/games/20260924-games-donkey-kongs-final-banana-bash-delights/","t":"ドンキーコング最後のバナナパーティーがゲーマーを喜ばせる","h":true,"s":"任天堂は「ドンキーコング：バナナブリス」で「バナナフリージーカーニバル」拡張機能を通じて、年間のテーマイベントシリーズを締めくくります。1週間にわたるこのイベントでは、プレイヤーは1400番目の地下レベルで絶え間ないチャレンジを体験できます。","i":"/img/2026-09-24/20260924-games-donkey-kongs-final-banana-bash-delights.webp","ci":"🎮","ct":"ゲーム","cc":"#eab308","d":"2026年9月24日","m":"2分で読める","tg":[{"u":"/ja/tag/games/","l":"ゲーム"},{"u":"/ja/tag/technology/","l":"テクノロジー"}]},{"u":"/ja/finance/20260923-finance-chinas-coffee-capital-brews-a-global/","t":"中国のコーヒーの首都、世界の金融界に波紋","h":true,"s":"上海は静かに世界で最も密集したコーヒーマーケットとなり、日常的なカフェイン習慣を激しい商業競争の場に変えています。この飲料ブームは、グローバルな資金が国内チェーンに資本を注ぎ込むにつれ、主要な消費者金融の注目を集めています。","i":"/img/2026-09-23/20260923-finance-chinas-coffee-capital-brews-a-global.webp","ci":"📈","ct":"金融","cc":"#0d9488","d":"2026年9月23日","m":"4分で読める","tg":[{"u":"/ja/tag/coffee/","l":"コーヒー"},{"u":"/ja/tag/economy/","l":"経済"}]},{"u":"/ja/science/20260923-science-chinas-quantum-leap-leading-the-next/","t":"中国の量子ジャンプ：次のコンピューティング革命をリード","h":true,"s":"中国の量子コンピューティング技術における急速な進歩は、計算科学の次の最前線における主要プレイヤーとしての地位を確立し、世界中の産業を変革する可能性のあるブレークスルーをもたらしています。","i":"/img/2026-09-23/20260923-science-chinas-quantum-leap-leading-the-next.webp","ci":"🔬","ct":"科学","cc":"#0891b2","d":"2026年9月23日","m":"2分で読める","tg":[{"u":"/ja/tag/technology/","l":"テクノロジー"},{"u":"/ja/tag/research/","l":"研究"}]},{"u":"/ja/sports/20260923-sports-chinas-running-revolution-marathon-culture-blooms/","t":"中国のランニング革命：マラソン文化が花開く","h":true,"s":"自転車の国だった中国が、ランニングマラソンに前代未聞の熱狂を示し、世界最大で最も活気のあるランニングコミュニティの一つを創り出した。","i":"/img/2026-09-23/20260923-sports-chinas-running-revolution-marathon-culture-blooms.webp","ci":"⚽","ct":"スポーツ","cc":"#ea580c","d":"2026年9月23日","m":"3分で読める","tg":[{"u":"/ja/tag/running/","l":"ランニング"},{"u":"/ja/tag/fitness/","l":"フィットネス"}]},{"u":"/ja/tech/20260923-tech-china-launches-satellite-internet-constellation/","t":"中国、衛星インターネットコンステレーションを打ち上げ","h":true,"s":"中国は、26の衛星グループの打ち上げを含む、野心的な宇宙ベースのインターネットプロジェクトの一環として、もう一組の低軌道衛星を成功裏に展開しました。","i":"/img/2026-09-23/20260923-tech-china-launches-satellite-internet-constellation.webp","ci":"💻","ct":"テクノロジー","cc":"#2563eb","d":"2026年9月23日","m":"2分で読める","tg":[{"u":"/ja/tag/space/","l":"宇宙"},{"u":"/ja/tag/research/","l":"研究"}]},{"u":"/ja/tech/20260922-tech-c919/","t":"中国のC919：国産旅客機が飛ぶ空を広げる","h":true,"s":"中国商飛（COMAC）が開発したナローボディ機C919が、最初の商用路線から次第に就航地を広げている。中国のフラッグシップ旅客機の中身と、乗ってみた印象を紹介する。","i":"/img/placeholder/tech.svg","ci":"💻","ct":"テクノロジー","cc":"#2563eb","d":"2026年9月22日","m":"1分で読める","tg":[{"u":"/ja/tag/aviation/","l":"航空"},{"u":"/ja/tag/c919/","l":"C919"}]},{"u":"/ja/finance/20260921-finance-ev-exports/","t":"中国EV輸出が世界の自動車地図を塗り替える","h":true,"s":"中国は今や世界最大の自動車輸出国となった。BYDや奇瑞（チェリー）、新興ブランドの電気自動車とプラグインハイブリッドが牽引するこの変化は、世界各地の車両価格に大きな影響を与えている。","i":"/img/placeholder/finance.svg","ci":"📈","ct":"金融","cc":"#0d9488","d":"2026年9月21日","m":"1分で読める","tg":[{"u":"/ja/tag/electric-vehicles/","l":"電気自動車"},{"u":"/ja/tag/exports/","l":"輸出"}]},{"u":"/ja/entertainment/20260919-entertainment-chinese-animation/","t":"ヒット作と記録：中国アニメーションは大人になった","h":true,"s":"『哪吒』シリーズの記録的ヒットから新進スタジオの台頭まで、中国のアニメ映画は国内興行の主力となり、次は海外観客を狙っている。","i":"/img/placeholder/entertainment.svg","ci":"🎬","ct":"エンタメ","cc":"#db2777","d":"2026年9月19日","m":"1分で読める","tg":[{"u":"/ja/tag/animation/","l":"アニメーション"},{"u":"/ja/tag/film/","l":"映画"}]},{"u":"/ja/science/20260917-science-tiangong/","t":"天宮：中国宇宙ステーションでの暮らしと科学","h":true,"s":"3人ずつの宇宙飛行士が交代で常駐する中国の宇宙ステーション「天宮」は、数百の実験を進め、世界中の実験装置にモジュールを開いている。","i":"/img/placeholder/science.svg","ci":"🔬","ct":"科学","cc":"#0891b2","d":"2026年9月17日","m":"1分で読める","tg":[{"u":"/ja/tag/space/","l":"宇宙"},{"u":"/ja/tag/tiangong/","l":"天宮"}]},{"u":"/ja/tech/20260924-tech-vivo-unveils-x500-with-cutting-edge-mediatek/","t":"Vivo、先進的なMediaTekプロセッサ搭載のX500を発表","h":false,"s":"中国のスマートフォンメーカーvivoが、新しいMediaチップを搭載した最新フラッグシップモデルを発売し、中国のモバイル技術におけるイノベーションを続けています。","i":"/img/2026-09-24/20260924-tech-vivo-unveils-x500-with-cutting-edge-mediatek.webp","ci":"💻","ct":"テクノロジー","cc":"#2563eb","d":"2026年9月24日","m":"3分で読める","tg":[{"u":"/ja/tag/technology/","l":"テクノロジー"},{"u":"/ja/tag/electric-vehicles/","l":"電気自動車"}]},{"u":"/ja/culture/20260923-culture-chinas-tea-traditions-in-modern-times/","t":"現代中国における茶の伝統","h":false,"s":"古代の儀式から現代の茶館まで、中国の5000年にわたる茶文化は、その深い伝統を保ちながらも絶えず進化し続けています。","i":"/img/2026-09-23/20260923-culture-chinas-tea-traditions-in-modern-times.webp","ci":"🏮","ct":"文化","cc":"#b45309","d":"2026年9月23日","m":"2分で読める","tg":[{"u":"/ja/tag/culture/","l":"文化"},{"u":"/ja/tag/tradition/","l":"伝統"}]},{"u":"/ja/culture/20260923-culture-the-ancient-art-of-chinese-shadow/","t":"中国の影絵の古代芸術が現代の光と出会う","h":false,"s":"精巧に彫られた革の人形を使う、千年以上にわたる物語の伝統である中国の影絵は、文化的な復興を経験しています。現代の芸術家や劇場は、古典的な物語を現代的な照明やデジタル投影技術と融合させることで、このユネスコ認定の芸術形式を保存しています。","i":"/img/2026-09-23/20260923-culture-the-ancient-art-of-chinese-shadow.webp","ci":"🏮","ct":"文化","cc":"#b45309","d":"2026年9月23日","m":"4分で読める","tg":[{"u":"/ja/tag/culture/","l":"文化"},{"u":"/ja/tag/tradition/","l":"伝統"}]},{"u":"/ja/entertainment/20260923-entertainment-chinese-animation-industry-captures-global-imagination/","t":"中国アニメ産業が世界の想像力を掴む","h":false,"s":"中国のアニメーション産業は国内制作から国際的に称賛される作品へと進化し、伝統的な文化的要素を最先端技術と融合させて世界の観客を魅了している。","i":"/img/2026-09-23/20260923-entertainment-chinese-animation-industry-captures-global-imagination.webp","ci":"🎬","ct":"エンタメ","cc":"#db2777","d":"2026年9月23日","m":"2分で読める","tg":[{"u":"/ja/tag/animation/","l":"アニメーション"},{"u":"/ja/tag/film/","l":"映画"}]},{"u":"/ja/lifestyle/20260923-lifestyle-beats-360-redefining-wireless-audio-experience/","t":"Beats 360: ワイヤレスオーディオ体験の再定義","h":false,"s":"AppleのオーディオブランドBeatsが3年ぶりに新しいオーバーオアヘッドフォンBeats 360を発表。プレミアムサウンドと革新的なデザインを融合させ、オーディオイノベーション20周年を記念します。","i":"/img/2026-09-23/20260923-lifestyle-beats-360-redefining-wireless-audio-experience.webp","ci":"🍜","ct":"ライフスタイル","cc":"#7c3aed","d":"2026年9月23日","m":"3分で読める","tg":[{"u":"/ja/tag/technology/","l":"テクノロジー"},{"u":"/ja/tag/daily-life/","l":"日常生活"}]},{"u":"/ja/travel/20260923-travel-chinas-high-speed-rail-network-connects-ancient/","t":"中国の高速鉄道ネットワークが古代と現代を結ぶ","h":false,"s":"中国の拡大する高速鉄道ネットワークは、世界で最も人口の多い国での旅行を変革し、歴史的なサイトを現代の都市と無比の速度で結びつけています。","i":"/img/2026-09-23/20260923-travel-chinas-high-speed-rail-network-connects-ancient.webp","ci":"✈️","ct":"旅行","cc":"#65a30d","d":"2026年9月23日","m":"2分で読める","tg":[{"u":"/ja/tag/high-speed-rail/","l":"高速鉄道"},{"u":"/ja/tag/travel-guide/","l":"旅行ガイド"}]},{"u":"/ja/sports/20260920-sports-marathon-boom/","t":"マラソン狂時代：中国でランニングが週末の習慣になった","h":false,"s":"抽選になるメガシティのマラソンから山岳トレイルレースまで、数千万人のランナーが週末のレースを国民的楽しみに変えた。","i":"/img/placeholder/sports.svg","ci":"⚽","ct":"スポーツ","cc":"#ea580c","d":"2026年9月20日","m":"1分で読める","tg":[{"u":"/ja/tag/marathon/","l":"マラソン"},{"u":"/ja/tag/running/","l":"ランニング"}]},{"u":"/ja/lifestyle/20260918-lifestyle-coffee-culture/","t":"お茶の国がコーヒーに夢中になる","h":false,"s":"中国は今や世界最大級のコーヒー市場の一つ。上海のスペシャルティロースターからアプリ中心のチェーンまで、コーヒーは静かに都市生活の一部になった。","i":"/img/placeholder/lifestyle.svg","ci":"🍜","ct":"ライフスタイル","cc":"#7c3aed","d":"2026年9月18日","m":"1分で読める","tg":[{"u":"/ja/tag/coffee/","l":"コーヒー"},{"u":"/ja/tag/cities/","l":"都市"}]},{"u":"/ja/travel/20260916-travel-high-speed-rail/","t":"時速350キロで見る中国：実用・高速鉄道ガイド","h":false,"s":"総延長4万5千キロ超の高速鉄道網が大都市と古都をつなぐ。中国を最も速く回る手段である高速鉄道の使い方を紹介する。","i":"/img/placeholder/travel.svg","ci":"✈️","ct":"旅行","cc":"#65a30d","d":"2026年9月16日","m":"1分で読める","tg":[{"u":"/ja/tag/high-speed-rail/","l":"高速鉄道"},{"u":"/ja/tag/travel-guide/","l":"旅行ガイド"}]},{"u":"/ja/culture/20260915-culture-hanfu-revival/","t":"漢服リバイバル：若い中国が伝統衣装を取り戻す","h":false,"s":"街角の公園で揺れる袖、漢服写真スタジオ、数十億元規模の市場——伝統衣装「漢服」は趣味のコスプレから日常のファッションへと変わった。","i":"/img/placeholder/culture.svg","ci":"🏮","ct":"文化","cc":"#b45309","d":"2026年9月15日","m":"1分で読める","tg":[{"u":"/ja/tag/hanfu/","l":"漢服"},{"u":"/ja/tag/fashion/","l":"ファッション"}]}]}